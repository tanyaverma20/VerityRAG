# Copy this file to .env and fill in your own values.
# Never commit .env — it's already covered by .gitignore.

# --- Required ---
GROQ_API_KEY=your_groq_api_key_here

# --- LLM (optional — these already have sensible defaults in config.py) ---
GROQ_MODEL=llama-3.3-70b-versatile
# Used only when the primary model has a temporary failure (rate limit,
# 5xx, timeout, or is unavailable/decommissioned) — tried at most once.
GROQ_FALLBACK_MODEL=openai/gpt-oss-120b

# --- Retrieval (optional) ---
CHROMA_DIR=./chroma_store
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
COLLECTION_NAME=verityrag_docs_v2

# --- Structured application persistence (db/ package) ---
# Set this to a real PostgreSQL URL in production, e.g.:
#   DATABASE_URL=postgresql+psycopg2://verityrag_user:PLACEHOLDER_PASSWORD@localhost:5432/verityrag
# Leave unset for local dev/tests — falls back to the SQLite file at
# REGISTRY_DB_PATH (data/registry.db by default), unchanged from before.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/verityrag
DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=10

# --- Production cache (cache.py) ---
# Set this to a real Redis URL in production, e.g.:
#   REDIS_URL=redis://:PLACEHOLDER_PASSWORD@localhost:6379/0
# Leave unset for local dev/tests — falls back to the existing in-memory
# cache automatically, and also falls back automatically if Redis is
# unreachable at runtime.
REDIS_URL=
CACHE_TTL_SECONDS=86400

# --- OCR fallback (optional; only used when a PDF's normal text
# extraction is empty/insufficient) ---
# Requires the Tesseract OCR system binary to be installed separately —
# this app never installs or assumes it; OCR is skipped with a clear
# status message if it isn't available.
OCR_ENABLED=true
TESSERACT_CMD=
